# better-sqlite3 ships N-API prebuilds for Windows/macOS/Linux. Without this, npm on Windows
# tries "node-gyp rebuild" anyway and fails unless Visual Studio Build Tools are installed.
# No other dependency here needs an install script.
ignore-scripts=true
# Electron's own binary (only needed for "npm start" in this folder) is fetched explicitly
# by the "electron:install" script; electron-builder downloads its own copy for packaging.
